# Supabase PostgreSQL Connection String (DATABASE_URL)
# Option A: Supabase Session Pooler (Recommended - supports IPv4 & IPv6, works on all networks and Render free tier):
# DATABASE_URL="postgresql://postgres.[project-ref]:YOUR_ACTUAL_PASSWORD@aws-0-[region].pooler.supabase.com:5432/postgres"
# Option B: Direct connection (IPv6-only networks):
# DATABASE_URL="postgresql://postgres:YOUR_ACTUAL_PASSWORD@db.[project-ref].supabase.co:5432/postgres"
DATABASE_URL="postgresql://postgres.[project-ref]:YOUR_ACTUAL_PASSWORD@aws-0-[region].pooler.supabase.com:5432/postgres"

# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# JWT Secret for RBAC Auth
JWT_SECRET=your_jwt_secret_key_here

# Frontend CORS Origin (comma-separated for multiple origins, e.g. Vercel deployment URL)
CORS_ORIGIN=http://localhost:5173,https://fiftyfiftygym.vercel.app

# Super Admin Account Bootstrap
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_INITIAL_PASSWORD=your_secure_superadmin_password_here

# Brevo Transactional Email Configuration
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FiftyFifty Gym
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration for Gym Logo Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
